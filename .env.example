# ── Kafka ────────────────────────────────────────────────────────────────────
# Bootstrap server for the local Docker Compose stack.
KAFKA_BOOTSTRAP=localhost:9092

# ── Schema Registry ───────────────────────────────────────────────────────────
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Consumer group ────────────────────────────────────────────────────────────
CONSUMER_GROUP=orders-consumer-group

# ── Retry policy ─────────────────────────────────────────────────────────────
# Total number of attempts (1 initial + N-1 retries).
MAX_ATTEMPTS=4

# Base delay for exponential backoff (seconds).
BACKOFF_BASE_S=0.5

# Maximum delay cap (seconds). Actual delay is uniform(0, min(cap, base*2^n)).
BACKOFF_CAP_S=8.0

# ── Fault injection ───────────────────────────────────────────────────────────
# Probability [0, 1] that the simulated downstream sink raises a TransientError.
# Set to 0.0 in production. Set to 0.25 in the demo Makefile target.
SINK_FAILURE_RATE=0.0
